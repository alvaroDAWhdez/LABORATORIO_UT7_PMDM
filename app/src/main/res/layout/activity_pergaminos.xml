<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#0D0D11">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PERGAMINOS DE LA CIUDADELA"
        android:textColor="#A29BFE"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="20dp"/>

    <EditText
        android:id="@+id/etNombreArchivo"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="Nombre del pergamino (ej: cronica.txt)"
        android:textColor="#FFFFFF"
        android:textColorHint="#75757A"
        android:backgroundTint="#6C5CE7"
        android:inputType="text"
        android:layout_marginBottom="12dp"/>

    <EditText
        android:id="@+id/etContenidoPergamino"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:hint="Escribe aquí el parte de exploración o crónica..."
        android:textColor="#FFFFFF"
        android:textColorHint="#75757A"
        android:background="#16161D"
        android:padding="12dp"
        android:gravity="top|start"
        android:inputType="textMultiLine"
        android:layout_marginBottom="16dp"/>

    <!-- Controles Memoria Interna -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bóveda Privada (Almacenamiento Interno)"
        android:textColor="#A29BFE"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <Button
            android:id="@+id/btnGuardarInterno"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Guardar Int."
            android:backgroundTint="#6C5CE7"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnLeerInterno"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Leer Int."
            android:backgroundTint="#2980B9"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

    <!-- Controles Memoria Externa -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mapas de Campaña (Externo / Documents)"
        android:textColor="#2ECC71"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginBottom="6dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnGuardarExterno"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Guardar Ext."
            android:backgroundTint="#27AE60"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="8dp"/>

        <Button
            android:id="@+id/btnLeerExterno"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Leer Ext."
            android:backgroundTint="#16A085"
            android:textColor="#FFFFFF"/>
    </LinearLayout>

</LinearLayout>