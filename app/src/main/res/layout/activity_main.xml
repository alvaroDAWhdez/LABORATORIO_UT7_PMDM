<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal|top"
    android:padding="24dp"
    android:background="#0D0D11"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Laboratorios UT7: Persistencia"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnLab1RegistroGuardia"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="Lab 1: Registro de Guardias"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#6C5CE7"
        android:layout_marginBottom="16dp"
        app:cornerRadius="10dp"/>

    <Button
        android:id="@+id/btnLab2Pergaminos"
        android:layout_width="280dp"
        android:layout_height="56dp"
        android:text="Lab 2: Los Pergaminos de la Ciudadela Blanca"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:backgroundTint="#27AE60"
        android:layout_marginBottom="16dp"
        app:cornerRadius="10dp"/>

    <!-- Futuros botones aquí -->

</LinearLayout>